# Salin file ini menjadi .env lalu isi.

# Alamat database PostgreSQL. Format: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DB
DATABASE_URL=postgresql://postgres:password@localhost:5432/portofolio
# Isi true kalau database di hosting (Supabase, Neon, Railway, dll) yang mewajibkan SSL
DATABASE_SSL=false

# Password untuk masuk ke halaman /admin
ADMIN_PASSWORD=ganti-dengan-password-kuat
# Kunci rahasia pembuat token login. Isi teks acak yang panjang (minimal 32 karakter)
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang-sekali

PORT=4000

# Opsional. Isi hanya kalau website (frontend) dihosting di alamat lain dari backend,
# contoh: https://portofolio-saya.vercel.app  (boleh banyak, pisahkan dengan koma)
CORS_ORIGIN=
# Opsional. Isi true kalau backend ada di belakang proxy hosting (Render, Railway, Nginx, dll)
TRUST_PROXY=false
